# Konfiguration des Einsatzplaners
# Kopiere diese Datei nach C:\einsatzplaner\einsatzplaner.env (Windows)
# oder /opt/einsatzplaner/einsatzplaner.env (Linux).
# Umgebungsvariablen haben Vorrang vor dieser Datei.

# --- Server ---
PORT=3010
# Adresse, auf der der Server lauscht. 127.0.0.1 = nur dieser Rechner.
# Läuft der Reverse-Proxy auf einem anderen Rechner im internen Netz, setze die interne Adresse.
LISTEN_HOST=127.0.0.1
# Öffentliche Adresse (hinter dem Reverse-Proxy mit HTTPS)
BASE_URL=https://einsatzplaner.example.ch
# Zufälliger Schlüssel, mindestens 32 Zeichen:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Datenbank (MySQL 8 oder MariaDB 10.6+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=einsatzplaner
DB_USER=einsatzplaner
DB_PASSWORD=

# --- Ordner ---
# Daten und Import-Dateien
DATA_DIR=C:\einsatzplaner\data
# Tagesexport und Sicherungen
EXPORT_DIR=C:\einsatzplaner\export

# --- Login mit Microsoft Entra ID ---
# TODO Yann
ENTRA_TENANT_ID=
# TODO Yann
ENTRA_CLIENT_ID=
# TODO Yann
ENTRA_CLIENT_SECRET=

# --- Mail (Exchange über SMTP) ---
# TODO Yann
SMTP_HOST=
# TODO Yann
SMTP_PORT=587
# TODO Yann
SMTP_USER=
# TODO Yann
SMTP_PASS=
# Aufgebotsadresse (Absender und Reply-To)
MAIL_FROM=aufgebot@kkb.ch
# Adresse der Informatik. Sie erhält die Mails von «Änderung melden» und pflegt Clubdesk.
# Der alte Name MAIL_ROMAN gilt weiter.
# TODO Yann
MAIL_INFORMATIK=
# Stunde der täglichen Bestätigungsmail (lokale Zeit)
BESTAETIGUNG_STUNDE=18

# --- Clubdesk ---
# Adresse des iCal-Feeds von Clubdesk
CLUBDESK_ICAL_URL=
# Seite, die das Anmeldeformular einbetten darf
FORM_ALLOWED_ORIGIN=https://www.kkb.ch

# --- Tagesexport nach SharePoint ---
# Stunde des Tagesexports (lokale Zeit)
EXPORT_HOUR=2
# TODO Yann
SHAREPOINT_SITE_ID=
# TODO Yann
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ORDNER=Einsatzplaner

# --- Update über Admin › Update ---
# 1 = Update erlaubt
UPDATE_ERLAUBT=0
UPDATE_BRANCH=main

# --- Nur für lokale Tests. NIE auf dem Server setzen. ---
# NODE_ENV=development
# DEV_LOGIN=1
