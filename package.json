{
  "name": "einsatzplaner",
  "version": "1.0.0",
  "private": true,
  "description": "Aufgebotstool (Einsatzplaner) der Verkehrskadetten des Kadetten-Korps Basel",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/kopiere-dateien.mjs",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test --test-concurrency=4 \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "node-ical": "^0.27.6",
    "nodemailer": "^10.6.0",
    "openid-client": "^6.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
